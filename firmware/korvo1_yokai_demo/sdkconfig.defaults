CONFIG_SPIRAM=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_TASK_WDT_TIMEOUT_S=15

# LVGL 9 Core Configurations
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=16
CONFIG_LV_OBJ_STYLE_CACHE=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_LV_USE_FLOAT=y
CONFIG_LV_DISABLE_ASSERT_HANDLER_INCLUDE_WARNING=y
# Preserve the verified production LVGL settings in fresh SDK configurations.
CONFIG_LV_COLOR_FORMAT_RGB565=y
CONFIG_LV_COLOR_MIX_ROUND_OFS=128
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_PRINTF=y
CONFIG_LV_USE_ASSERT_MALLOC=y
CONFIG_LV_USE_ASSERT_NULL=y
CONFIG_LV_ASSERT_HANDLER_INCLUDE="assert.h"
CONFIG_LV_USE_SYSMON=y
CONFIG_LV_USE_PERF_MONITOR=y
CONFIG_LV_USE_PERF_MONITOR_LOG_MODE=y
CONFIG_LV_CHECK_ARG_LOG_MODE_NONE=y
CONFIG_LV_USE_THEME_MONO=n
CONFIG_LV_TXT_BREAK_CHARS=" ,.;:-_)}"

# Fonts (Montserrat + Source Han Sans CJK)
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_SOURCE_HAN_SANS_SC_16_CJK=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_16=y

# esp_lvgl_adapter & ThorVG Lottie stack
CONFIG_ESP_LV_ADAPTER_TASK_STACK_SIZE=32768
CONFIG_ESP_LV_ADAPTER_TASK_PRIORITY=6

# Wi-Fi & LWIP memory optimization
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0

# Bluetooth Classic & A2DP Sink (BR/EDR only saves ~60KB internal SRAM)
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_DISABLE=y

# ESP-DSP SIMD & Hardware Vector Acceleration
CONFIG_DSP_OPTIMIZATIONS_SUPPORTED=y
CONFIG_DSP_OPTIMIZED=y
CONFIG_DSP_OPTIMIZATION=1
CONFIG_DSP_MAX_FFT_SIZE_4096=y
CONFIG_DSP_MAX_FFT_SIZE=4096

# ESP-DL SIMD Hardware Acceleration & Pixel Formats
CONFIG_PIX_CVT_RGB565_TO_RGB888_SUPPORT=y
CONFIG_PIX_CVT_RGB565_TO_GRAY_SUPPORT=y
CONFIG_PIX_CVT_RGB888_TO_RGB565_SUPPORT=y
CONFIG_PIX_CVT_RGB888_TO_GRAY_SUPPORT=y

# ESP-SR global bilingual command control
CONFIG_MODEL_IN_FLASH=y
CONFIG_SR_WN_WN9_HIESP=y
CONFIG_SR_MN_EN_MULTINET7_QUANT=y

# Camera & Sensor Support



# ESP-DL Human Face Recognition (MFN S8 V1 in Flash rodata)
CONFIG_FLASH_HUMAN_FACE_FEAT_MFN_S8_V1=y
CONFIG_HUMAN_FACE_FEAT_MFN_S8_V1=y
CONFIG_HUMAN_FACE_FEAT_MODEL_IN_FLASH_RODATA=y

# Live preview scaling into the existing LVGL drawing framebuffer.
CONFIG_LV_USE_PPA=y
CONFIG_LV_USE_PPA_IMG=y
CONFIG_LV_DRAW_BUF_ALIGN=64
CONFIG_LV_PPA_BURST_LENGTH_64=y
